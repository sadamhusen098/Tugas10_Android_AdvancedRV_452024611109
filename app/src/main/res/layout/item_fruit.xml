<?xml version="1.0" encoding="utf-8"?>
<!-- View Type ITEM (buah/sayur): 1 span. 
     Menggunakan BindingAdapter kustom via XML:
       app:cardTint   -> setCardTint(view, colorRes)
       app:priceFormat-> setPriceFormat(view, price)
       app:ratingText -> setRatingText(view, rating) -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="item"
            type="com.example.android.advancedrv.model.ListItem.FruitItem" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardTint="@{item.colorRes}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{item.emoji}"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@{item.name}"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{item.category}"
                android:textColor="@color/textSecondary"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="10sp"
                android:textStyle="bold"
                app:ratingText="@{item.rating}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/textPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:priceFormat="@{item.price}" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
